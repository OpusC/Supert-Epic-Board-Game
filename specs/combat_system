## CombatPresenter
extends Node
animation_queue : Array = []
var is_playing : bool = false

func _ready()
	combat_event_bus.move_resolved.connect(_on_move_resolved)

func _on_move_resolved(move, result):
	animation_queue.append(move)
	if not is_playing:
		_play_next()

func _play_next():
	if animation_queue.is_empty():
		return
	var move = animation_queue.pop_front()
	var animation = get_animation_for(move)
	await anim.finished
	_play_next()

## HealthBar
func _on_move_resolved(move, result):
